{:paths ["resources"]

 ;; Sibling checkouts during development go in the untracked local.deps.edn:
 ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:test
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-olympus {:mvn/version "0.1.9"}}

 :aliases
 {;; hive-vessel: the :host-target route lowers through its standard registry.
  ;; In a hive it arrives with hive.universe; the stub host here has to bring it.
  :test {:extra-paths ["test"]
         :extra-deps {io.github.hive-agi/hive-vessel {:mvn/version "0.1.11"}}
         :jvm-opts ["-Xmx1g"]
         :main-opts ["-m" "hive-olympus-universe.test-runner"]}

  ;; The live proof: the real Olympus refresh loop onto a real universe canvas.
  ;; Needs the hive-universe checkout (local.deps.edn) and its test root, which
  ;; is where the port-conformance-proven AtomUniverse lives.
  ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:proof
  :proof {:extra-paths ["test" "../hive-universe/test"]
          :extra-deps {io.github.hive-agi/hive-vessel {:mvn/version "0.1.11"}}
          :jvm-opts ["-Xmx1g"]
          :main-opts ["-m" "hive-olympus-universe.proof-runner"]}

  ;; Watch it. Boots the manager's default universe, mounts the grid onto its
  ;; canvas and hands over the terminal. The canvas deps are hive-universe's
  ;; :shell alias, which a :local/root cannot contribute, so they are named here.
  ;;   clojure -Sdeps "$(cat local.deps.edn)" -M:demo [--live]
  :demo {:extra-paths ["dev"]
         :extra-deps {io.github.hive-agi/hive-vessel {:mvn/version "0.1.11"}
                      org.replikativ/spindel {:mvn/version "0.1.52"}
                      org.replikativ/spindel-tui {:mvn/version "0.1.14"}
                      io.github.hive-agi/hive-events
                      {:git/tag "v0.5.17" :git/sha "250eb7a"}}
         :jvm-opts ["-Xmx1g"]
         :main-opts ["-m" "hive-olympus-universe.canvas-demo"]}}}
